# Postgres (Supabase). Use the Session pooler (port 5432) or direct connection for Prisma.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres.kpbqyxynxwwipuhroyth:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Direct connection (used by prisma migrate). Same as above for Supabase session pooler is fine.
DIRECT_URL="postgresql://postgres.kpbqyxynxwwipuhroyth:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 32+ random bytes, base64. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the web app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email notifications (optional). Unset SMTP_URL = in-app notifications only.
# Gmail: smtps://user%40gmail.com:APP_PASSWORD@smtp.gmail.com:465 (URL-encode @ and special chars)
SMTP_URL=""
# Sender shown on emails
MAIL_FROM="Ugnayo <no-reply@hris.local>"
# Base URL for links in emails. Falls back to NEXT_PUBLIC_APP_URL, then https://$VERCEL_PROJECT_PRODUCTION_URL
APP_URL="http://localhost:3000"

# Error monitoring (Sentry). Leave empty to disable (local, CI, e2e).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Trace sampling 0..1 (default 0.1). The NEXT_PUBLIC_ one applies in the browser.
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# Optional, build-time only: source-map upload. Without a token the build skips it.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Nightly backups (.github/workflows/db-backup.yml) read these from GitHub Actions secrets, not from this file:
# BACKUP_DATABASE_URL = Supabase Session pooler URI (port 5432), BACKUP_PASSPHRASE = openssl rand -base64 32

# AI assistant and resume screening. Leave empty to turn AI off; AI_PROVIDER=mock for an offline fake.
ANTHROPIC_API_KEY=
# Only if your API key is not scoped to a workspace (Anthropic returns 400 without it).
ANTHROPIC_WORKSPACE_ID=
