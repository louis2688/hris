generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
  // Nested include/select in one SQL query (LATERAL joins) instead of one query per relation level.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DayPart {
  FULL
  AM
  PM
}

enum ApproverKind {
  MANAGER
  HR
  ADMIN
}

enum QualificationKind {
  SKILL
  LICENSE
  MEMBERSHIP
}

enum PunchDirection {
  IN
  OUT
}

enum PunchSource {
  WEB
  MOBILE
  DEVICE
  MANUAL
}

enum PunchMethod {
  NONE
  PASSKEY
  PHOTO
  FINGERPRINT
  FACE
  CARD
  PIN
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum CandidateStage {
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ReviewStatus {
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

enum LeaveEventAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  COMMENTED
}

enum DocumentCategory {
  CONTRACT
  ID
  RESUME
  CERTIFICATE
  PAYSLIP
  OTHER
}

// ---------- Identity ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee      Employee?
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
  leaveEvents   LeaveRequestEvent[]
  passkeys      Passkey[]
  identities    UserIdentity[]
  deviceTokens  DeviceToken[]
  announcements Announcement[]
  acks          AnnouncementAck[]
  tasksDone     EmployeeTask[]
  documents     Document[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Organisation ----------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  headId    String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  head      Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  employees Employee[]
  vacancies Vacancy[]
}

model JobTitle {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  vacancies Vacancy[]
  kpis      Kpi[]
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  city      String?
  country   String?
  timezone  String?
  /// Geofence for web/mobile punches (meters). Null = no geofence.
  latitude       Float?
  longitude      Float?
  geofenceRadius Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  holidays  Holiday[]
  vacancies Vacancy[]
  devices   BiometricDevice[]
}

model Holiday {
  id         String   @id @default(cuid())
  name       String
  date       DateTime @db.Date
  locationId String?
  type       HolidayType @default(REGULAR)
  createdAt  DateTime @default(now())

  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([date, locationId])
  @@index([date])
}

// ---------- People ----------

model Employee {
  id            String  @id @default(cuid())
  employeeCode  String  @unique
  userId        String? @unique

  // Personal
  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  gender        Gender         @default(UNDISCLOSED)
  dateOfBirth   DateTime?      @db.Date
  maritalStatus MaritalStatus?
  nationality   String?
  avatarUrl     String?

  // Contact
  workEmail     String?
  personalEmail String?
  phone         String?
  mobile        String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?

  // Job
  departmentId     String?
  jobTitleId       String?
  locationId       String?
  managerId        String?
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  hireDate         DateTime         @db.Date
  terminationDate  DateTime?        @db.Date
  notes            String?
  shiftId          String?
  biometricId      String?          @unique

  // Payroll
  payType      PayType  @default(MONTHLY)
  /// Monthly salary (MONTHLY) or daily rate (DAILY), PHP
  basicPay     Decimal? @db.Decimal(12, 2)
  /// Non-taxable de minimis allowance per month, PHP
  allowance    Decimal  @default(0) @db.Decimal(12, 2)
  tin          String?
  sssNo        String?
  philhealthNo String?
  pagibigNo    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  manager    Employee?   @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Employee[]  @relation("ReportsTo")

  headOfDepartments Department[]       @relation("DepartmentHead")
  emergencyContacts EmergencyContact[]
  leaveEntitlements LeaveEntitlement[]
  leaveRequests     LeaveRequest[]
  approvedRequests  LeaveRequest[]     @relation("LeaveApprover")
  shift             WorkShift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  qualifications    EmployeeQualification[]
  punches           AttendancePunch[]
  timesheets        Timesheet[]        @relation("TimesheetOwner")
  decidedTimesheets Timesheet[]        @relation("TimesheetDecider")
  managedVacancies  Vacancy[]
  hiredFrom         Candidate?
  interviews        Interview[]
  reviews           PerformanceReview[] @relation("Reviewee")
  reviewsToGive     PerformanceReview[] @relation("Reviewer")
  payslips          Payslip[]
  overtimeRequests  OvertimeRequest[]  @relation("OvertimeOwner")
  overtimeToDecide  OvertimeRequest[]  @relation("OvertimeApprover")
  coeRequests       CoeRequest[]
  expenseClaims     ExpenseClaim[]     @relation("ExpenseOwner")
  expensesToDecide  ExpenseClaim[]     @relation("ExpenseApprover")
  loans             Loan[]
  checklists        EmployeeChecklist[]
  assets            Asset[]
  shiftAssignments  ShiftAssignment[]
  swapRequests      ShiftSwapRequest[] @relation("SwapRequester")
  swapTargets       ShiftSwapRequest[] @relation("SwapTarget")
  documents         Document[]

  @@index([lastName, firstName])
  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([locationId])
  @@index([jobTitleId])
  @@index([shiftId])
}

model EmergencyContact {
  id           String  @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  isPrimary    Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ---------- Leave ----------

model LeaveType {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String   @unique
  color              String   @default("#2563eb")
  isPaid             Boolean  @default(true)
  requiresApproval   Boolean  @default(true)
  allowHalfDay       Boolean  @default(true)
  defaultDays        Decimal  @default(0) @db.Decimal(5, 2)
  maxConsecutiveDays Int?
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  /// Sequential approvers, e.g. [MANAGER, HR]. Empty or requiresApproval=false means auto-approve.
  approvalChain      ApproverKind[] @default([MANAGER])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entitlements LeaveEntitlement[]
  requests     LeaveRequest[]
}

model LeaveEntitlement {
  id           String   @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  year         Int
  entitledDays Decimal  @db.Decimal(5, 2)
  carriedOver  Decimal  @default(0) @db.Decimal(5, 2)
  adjustment   Decimal  @default(0) @db.Decimal(5, 2)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([year])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  startDayPart DayPart     @default(FULL)
  endDayPart   DayPart     @default(FULL)
  totalDays    Decimal     @db.Decimal(5, 2)
  reason       String?
  status       LeaveStatus @default(PENDING)
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  cancelledAt  DateTime?
  /// Snapshot of the leave type chain at submit time; currentLevel indexes into it.
  approvalChain ApproverKind[] @default([])
  currentLevel  Int            @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee  Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType           @relation(fields: [leaveTypeId], references: [id])
  approver  Employee?           @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  events    LeaveRequestEvent[]

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([startDate, endDate])
  @@index([leaveTypeId])
}

model LeaveRequestEvent {
  id          String           @id @default(cuid())
  requestId   String
  actorUserId String?
  action      LeaveEventAction
  level       Int?
  note        String?
  createdAt   DateTime         @default(now())

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

// ---------- Platform ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([entity, createdAt])
  @@index([actorUserId])
}

// ---------- Qualifications (PIM) ----------

model Nationality {
  id   String @id @default(cuid())
  name String @unique
}

model Qualification {
  id          String            @id @default(cuid())
  kind        QualificationKind
  name        String
  description String?
  createdAt   DateTime          @default(now())

  holders EmployeeQualification[]

  @@unique([kind, name])
}

model EmployeeQualification {
  id              String    @id @default(cuid())
  employeeId      String
  qualificationId String
  /// Skill: proficiency / years. License: - . Membership: subscription paid by.
  level           String?
  /// License number or membership id.
  number          String?
  issuedDate      DateTime? @db.Date
  expiryDate      DateTime? @db.Date
  amount          Decimal?  @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime  @default(now())

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([qualificationId])
}

// ---------- Time & attendance ----------

model WorkShift {
  id           String   @id @default(cuid())
  name         String   @unique
  /// HH:mm in the employee's location timezone
  startTime    String   @default("09:00")
  endTime      String   @default("18:00")
  breakMinutes Int      @default(60)
  graceMinutes Int      @default(0)
  /// 0 = Sunday .. 6 = Saturday
  workDays     Int[]    @default([1, 2, 3, 4, 5])
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  employees   Employee[]
  assignments ShiftAssignment[]
}

model AttendancePunch {
  id          String          @id @default(cuid())
  employeeId  String
  at          DateTime
  direction   PunchDirection?
  source      PunchSource
  method      PunchMethod     @default(NONE)
  deviceId    String?
  latitude    Float?
  longitude   Float?
  note        String?
  /// Small JPEG selfie. Omitted from queries by default (see db client).
  photo       Bytes?
  createdById String?
  createdAt   DateTime        @default(now())

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, at])
  @@index([at])
}

model BiometricDevice {
  id         String    @id @default(cuid())
  name       String
  serial     String    @unique
  locationId String?
  apiKeyHash String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  location Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  punches  AttendancePunch[]
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Timesheets ----------

model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  client    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries TimesheetEntry[]
}

model Timesheet {
  id           String          @id @default(cuid())
  employeeId   String
  /// Monday of the week
  weekStart    DateTime        @db.Date
  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  employee  Employee         @relation("TimesheetOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee?        @relation("TimesheetDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  entries   TimesheetEntry[]

  @@unique([employeeId, weekStart])
  @@index([status])
}

model TimesheetEntry {
  id          String   @id @default(cuid())
  timesheetId String
  projectId   String
  activity    String?
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(4, 2)

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([timesheetId])
  @@index([projectId])
  @@index([date])
}

// ---------- Recruitment ----------

model Vacancy {
  id              String        @id @default(cuid())
  title           String
  jobTitleId      String?
  departmentId    String?
  locationId      String?
  hiringManagerId String?
  positions       Int           @default(1)
  description     String?
  status          VacancyStatus @default(OPEN)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  jobTitle      JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location      Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hiringManager Employee?   @relation(fields: [hiringManagerId], references: [id], onDelete: SetNull)
  candidates    Candidate[]
}

model Candidate {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  vacancyId       String?
  stage           CandidateStage @default(APPLIED)
  source          String?
  resumeUrl       String?
  notes           String?
  appliedAt       DateTime       @default(now()) @db.Date
  hiredEmployeeId String?        @unique
  /// AI resume screening (0-100), null until screened
  aiScore         Int?
  aiSummary       String?
  aiScreenedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vacancy       Vacancy?    @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  hiredEmployee Employee?   @relation(fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  interviews    Interview[]
  documents     Document[]

  @@index([vacancyId])
  @@index([stage])
}

model Interview {
  id            String          @id @default(cuid())
  candidateId   String
  title         String
  scheduledAt   DateTime
  interviewerId String?
  location      String?
  result        InterviewResult @default(PENDING)
  notes         String?
  createdAt     DateTime        @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer Employee? @relation(fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([scheduledAt])
  @@index([interviewerId])
}

// ---------- Performance ----------

model Kpi {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Null = applies to everyone
  jobTitleId  String?
  minRating   Int      @default(1)
  maxRating   Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  jobTitle JobTitle?    @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  items    ReviewItem[]
}

model ReviewCycle {
  id          String            @id @default(cuid())
  name        String
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  dueDate     DateTime          @db.Date
  status      ReviewCycleStatus @default(DRAFT)
  createdAt   DateTime          @default(now())

  reviews PerformanceReview[]
}

model PerformanceReview {
  id             String       @id @default(cuid())
  cycleId        String
  employeeId     String
  reviewerId     String?
  status         ReviewStatus @default(SELF_REVIEW)
  selfComment    String?
  managerComment String?
  finalRating    Decimal?     @db.Decimal(3, 2)
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cycle    ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee     @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee?    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  items    ReviewItem[]

  @@unique([cycleId, employeeId])
  @@index([reviewerId])
  @@index([employeeId])
}

model ReviewItem {
  id             String  @id @default(cuid())
  reviewId       String
  kpiId          String?
  kpiName        String
  minRating      Int
  maxRating      Int
  selfRating     Int?
  selfComment    String?
  managerRating  Int?
  managerComment String?

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  kpi    Kpi?              @relation(fields: [kpiId], references: [id], onDelete: SetNull)

  @@index([reviewId])
}

// ---------- Documents ----------

/// File bytes live in Postgres. `data` is omitted from queries by default (see db client).
model Document {
  id                String           @id @default(cuid())
  employeeId        String?
  candidateId       String?
  category          DocumentCategory
  name              String
  mimeType          String
  size              Int
  data              Bytes
  sha256            String
  uploadedById      String?
  visibleToEmployee Boolean          @default(true)
  createdAt         DateTime         @default(now())

  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  candidate  Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  expenseClaims ExpenseClaim[]

  @@index([employeeId])
  @@index([candidateId])
}

// ---------- Payroll, requests, people ops, platform (2026-10) ----------

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
}

enum PayType {
  MONTHLY
  DAILY
}

enum PayFrequency {
  SEMI_MONTHLY
  MONTHLY
}

enum PayrollKind {
  REGULAR
  THIRTEENTH_MONTH
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanType {
  CASH_ADVANCE
  COMPANY_LOAN
  SSS_LOAN
  PAGIBIG_LOAN
}

enum LoanStatus {
  PENDING
  ACTIVE
  PAID
  REJECTED
  CANCELLED
}

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

enum TaskOwner {
  HR
  MANAGER
  EMPLOYEE
  IT
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  RETIRED
}

model PayrollRun {
  id          String        @id @default(cuid())
  name        String
  kind        PayrollKind   @default(REGULAR)
  frequency   PayFrequency  @default(SEMI_MONTHLY)
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  payDate     DateTime      @db.Date
  status      PayrollStatus @default(DRAFT)
  createdById String?
  finalizedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payslips      Payslip[]
  reimbursed    ExpenseClaim[]

  @@index([periodStart])
}

model Payslip {
  id              String   @id @default(cuid())
  runId           String
  employeeId      String
  basicPay        Decimal  @db.Decimal(12, 2)
  grossPay        Decimal  @db.Decimal(12, 2)
  sss             Decimal  @default(0) @db.Decimal(12, 2)
  philhealth      Decimal  @default(0) @db.Decimal(12, 2)
  pagibig         Decimal  @default(0) @db.Decimal(12, 2)
  withholdingTax  Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)
  netPay          Decimal  @db.Decimal(12, 2)
  /// Itemized earnings/deductions: [{ kind: "earning"|"deduction", code, label, amount, qty? }]
  lines           Json
  createdAt       DateTime @default(now())

  run          PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanPayments LoanPayment[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

model OvertimeRequest {
  id           String        @id @default(cuid())
  employeeId   String
  date         DateTime      @db.Date
  /// HH:mm local time
  startTime    String
  endTime      String
  minutes      Int
  reason       String
  status       RequestStatus @default(PENDING)
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  employee Employee  @relation("OvertimeOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee? @relation("OvertimeApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([status])
}

model CoeRequest {
  id                  String        @id @default(cuid())
  employeeId          String
  purpose             String
  includeCompensation Boolean       @default(false)
  status              RequestStatus @default(PENDING)
  decidedById         String?
  decidedAt           DateTime?
  note                String?
  createdAt           DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model ExpenseClaim {
  id                String        @id @default(cuid())
  employeeId        String
  date              DateTime      @db.Date
  category          String
  amount            Decimal       @db.Decimal(12, 2)
  description       String
  status            RequestStatus @default(PENDING)
  approverId        String?
  decidedAt         DateTime?
  decisionNote      String?
  receiptId         String?
  reimbursedInRunId String?
  createdAt         DateTime      @default(now())

  employee   Employee    @relation("ExpenseOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver   Employee?   @relation("ExpenseApprover", fields: [approverId], references: [id], onDelete: SetNull)
  receipt    Document?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  reimbursedIn PayrollRun? @relation(fields: [reimbursedInRunId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
}

model Loan {
  id           String     @id @default(cuid())
  employeeId   String
  type         LoanType
  principal    Decimal    @db.Decimal(12, 2)
  /// Deducted per payroll run
  amortization Decimal    @db.Decimal(12, 2)
  balance      Decimal    @db.Decimal(12, 2)
  startDate    DateTime   @db.Date
  status       LoanStatus @default(PENDING)
  reason       String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([employeeId])
  @@index([status])
}

model LoanPayment {
  id        String   @id @default(cuid())
  loanId    String
  payslipId String?
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  note      String?

  loan    Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payslip Payslip? @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([payslipId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  pinned      Boolean   @default(false)
  requiresAck Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  acks   AnnouncementAck[]

  @@index([publishedAt])
}

model AnnouncementAck {
  announcementId String
  userId         String
  ackedAt        DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

model ChecklistTemplate {
  id        String        @id @default(cuid())
  name      String
  kind      ChecklistKind
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())

  items      ChecklistTemplateItem[]
  checklists EmployeeChecklist[]
}

model ChecklistTemplateItem {
  id            String    @id @default(cuid())
  templateId    String
  title         String
  owner         TaskOwner @default(HR)
  /// Days after start (onboarding) or before last day (offboarding)
  dueOffsetDays Int       @default(0)
  sortOrder     Int       @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model EmployeeChecklist {
  id          String        @id @default(cuid())
  employeeId  String
  kind        ChecklistKind
  templateId  String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks    EmployeeTask[]

  @@index([employeeId])
}

model EmployeeTask {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  owner       TaskOwner @default(HR)
  dueDate     DateTime? @db.Date
  doneAt      DateTime?
  doneById    String?
  sortOrder   Int       @default(0)

  checklist EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy    User?             @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@index([checklistId])
}

model Asset {
  id           String      @id @default(cuid())
  tag          String      @unique
  name         String
  category     String
  serialNumber String?
  purchaseDate DateTime?   @db.Date
  cost         Decimal?    @db.Decimal(12, 2)
  status       AssetStatus @default(AVAILABLE)
  assignedToId String?
  assignedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedTo Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([status])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date
  /// Null = rest day
  shiftId    String?
  note       String?
  createdAt  DateTime @default(now())

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    WorkShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}

model ShiftSwapRequest {
  id               String        @id @default(cuid())
  requesterId      String
  targetId         String
  date             DateTime      @db.Date
  reason           String?
  targetAcceptedAt DateTime?
  status           RequestStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())

  requester Employee @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    Employee @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  /// "google" | "microsoft"
  provider  String
  subject   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  /// Expo push token
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
