generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
  // Nested include/select in one SQL query (LATERAL joins) instead of one query per relation level.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DayPart {
  FULL
  AM
  PM
}

enum ApproverKind {
  MANAGER
  HR
  ADMIN
}

enum QualificationKind {
  SKILL
  LICENSE
  MEMBERSHIP
}

enum PunchDirection {
  IN
  OUT
}

enum PunchSource {
  WEB
  MOBILE
  DEVICE
  MANUAL
}

enum PunchMethod {
  NONE
  PASSKEY
  PHOTO
  FINGERPRINT
  FACE
  CARD
  PIN
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum CandidateStage {
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewResult {
  PENDING
  PASSED
  FAILED
}

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ReviewStatus {
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

enum LeaveEventAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  COMMENTED
}

enum DocumentCategory {
  CONTRACT
  ID
  RESUME
  CERTIFICATE
  PAYSLIP
  OTHER
}

// ---------- Identity ----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Tokens issued before this are dead (logout, password change/reset).
  sessionsValidAfter DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee      Employee?
  refreshTokens RefreshToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
  leaveEvents   LeaveRequestEvent[]
  passkeys      Passkey[]
  identities    UserIdentity[]
  deviceTokens  DeviceToken[]
  announcements Announcement[]
  acks          AnnouncementAck[]
  tasksDone     EmployeeTask[]
  documentAcks  DocumentAck[]
  caseEvents    CaseEvent[]
  documents     Document[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Organisation ----------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  headId    String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  head      Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentTree")
  employees Employee[]
  vacancies Vacancy[]
  blockDates LeaveBlockDate[]
  offers    JobOffer[]
}

model JobTitle {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  vacancies Vacancy[]
  kpis      Kpi[]
  offers      JobOffer[]
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  city      String?
  country   String?
  timezone  String?
  /// Geofence for web/mobile punches (meters). Null = no geofence.
  latitude       Float?
  longitude      Float?
  geofenceRadius Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
  holidays  Holiday[]
  vacancies Vacancy[]
  devices   BiometricDevice[]
}

model Holiday {
  id         String   @id @default(cuid())
  name       String
  date       DateTime @db.Date
  locationId String?
  type       HolidayType @default(REGULAR)
  createdAt  DateTime @default(now())

  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([date, locationId])
  @@index([date])
}

// ---------- People ----------

model Employee {
  id            String  @id @default(cuid())
  employeeCode  String  @unique
  userId        String? @unique

  // Personal
  firstName     String
  middleName    String?
  lastName      String
  preferredName String?
  gender        Gender         @default(UNDISCLOSED)
  dateOfBirth   DateTime?      @db.Date
  maritalStatus MaritalStatus?
  nationality   String?
  avatarUrl     String?

  // Contact
  workEmail     String?
  personalEmail String?
  phone         String?
  mobile        String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?

  // Job
  departmentId     String?
  jobTitleId       String?
  locationId       String?
  managerId        String?
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  hireDate         DateTime         @db.Date
  terminationDate  DateTime?        @db.Date
  notes            String?
  shiftId          String?
  biometricId      String?          @unique

  // Payroll
  payType      PayType  @default(MONTHLY)
  /// Monthly salary (MONTHLY) or daily rate (DAILY), PHP
  basicPay     Decimal? @db.Decimal(12, 2)
  /// Non-taxable de minimis allowance per month, PHP
  allowance    Decimal  @default(0) @db.Decimal(12, 2)
  tin          String?
  sssNo        String?
  philhealthNo String?
  pagibigNo    String?

  // Bank disbursement
  bankName      String?
  bankAccountNo String?
  /// Values for CustomFieldDef keys
  customFields  Json     @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  location   Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  manager    Employee?   @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports    Employee[]  @relation("ReportsTo")

  headOfDepartments Department[]       @relation("DepartmentHead")
  emergencyContacts EmergencyContact[]
  leaveEntitlements LeaveEntitlement[]
  leaveRequests     LeaveRequest[]
  approvedRequests  LeaveRequest[]     @relation("LeaveApprover")
  shift             WorkShift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  qualifications    EmployeeQualification[]
  punches           AttendancePunch[]
  timesheets        Timesheet[]        @relation("TimesheetOwner")
  decidedTimesheets Timesheet[]        @relation("TimesheetDecider")
  managedVacancies  Vacancy[]
  hiredFrom         Candidate?
  interviews        Interview[]
  reviews           PerformanceReview[] @relation("Reviewee")
  reviewsToGive     PerformanceReview[] @relation("Reviewer")
  payslips          Payslip[]
  overtimeRequests  OvertimeRequest[]  @relation("OvertimeOwner")
  overtimeToDecide  OvertimeRequest[]  @relation("OvertimeApprover")
  coeRequests       CoeRequest[]
  expenseClaims     ExpenseClaim[]     @relation("ExpenseOwner")
  expensesToDecide  ExpenseClaim[]     @relation("ExpenseApprover")
  loans             Loan[]
  checklists        EmployeeChecklist[]
  assets            Asset[]
  shiftAssignments  ShiftAssignment[]
  swapRequests      ShiftSwapRequest[] @relation("SwapRequester")
  swapTargets       ShiftSwapRequest[] @relation("SwapTarget")
  payrollAdjustments PayrollAdjustment[]
  compensations      EmployeeCompensation[]
  separations        Separation[]
  benefits           EmployeeBenefit[]
  corrections        AttendanceCorrection[] @relation("CorrectionOwner")
  correctionsToDecide AttendanceCorrection[] @relation("CorrectionApprover")
  compOffRequests    CompOffRequest[]
  leaveEncashments   LeaveEncashment[]
  shiftChangeRequests ShiftChangeRequest[]
  availability       Availability[]
  referrals          Candidate[]        @relation("CandidateReferrer")
  interviewFeedback  InterviewFeedback[]
  employmentEvents   EmploymentEvent[]
  goals              Goal[]
  peerFeedbackGiven  PeerFeedback[]
  oneOnOnesAsManager OneOnOne[]         @relation("OneOnOneManager")
  oneOnOnes          OneOnOne[]         @relation("OneOnOneEmployee")
  trainings          TrainingAttendee[]
  surveyParticipation SurveyParticipation[]
  cases              GrievanceCase[]
  documents         Document[]

  @@index([lastName, firstName])
  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
  @@index([locationId])
  @@index([jobTitleId])
  @@index([shiftId])
}

model EmergencyContact {
  id           String  @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  phone        String
  isPrimary    Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ---------- Leave ----------

model LeaveType {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String   @unique
  color              String   @default("#2563eb")
  isPaid             Boolean  @default(true)
  requiresApproval   Boolean  @default(true)
  allowHalfDay       Boolean  @default(true)
  defaultDays        Decimal  @default(0) @db.Decimal(5, 2)
  maxConsecutiveDays Int?
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  /// Sequential approvers, e.g. [MANAGER, HR]. Empty or requiresApproval=false means auto-approve.
  approvalChain      ApproverKind[] @default([MANAGER])
  /// Days earned per month; null = full defaultDays granted upfront
  accrualPerMonth    Decimal? @db.Decimal(5, 2)
  allowEncashment    Boolean  @default(false)
  /// Credited through approved comp-off requests
  isCompensatory     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  entitlements LeaveEntitlement[]
  requests     LeaveRequest[]
  compOffs     CompOffRequest[]
  encashments  LeaveEncashment[]
}

model LeaveEntitlement {
  id           String   @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  year         Int
  entitledDays Decimal  @db.Decimal(5, 2)
  carriedOver  Decimal  @default(0) @db.Decimal(5, 2)
  adjustment   Decimal  @default(0) @db.Decimal(5, 2)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([year])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  startDayPart DayPart     @default(FULL)
  endDayPart   DayPart     @default(FULL)
  totalDays    Decimal     @db.Decimal(5, 2)
  reason       String?
  status       LeaveStatus @default(PENDING)
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  cancelledAt  DateTime?
  /// Snapshot of the leave type chain at submit time; currentLevel indexes into it.
  approvalChain ApproverKind[] @default([])
  currentLevel  Int            @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee  Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType           @relation(fields: [leaveTypeId], references: [id])
  approver  Employee?           @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  events    LeaveRequestEvent[]

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([startDate, endDate])
  @@index([leaveTypeId])
}

model LeaveRequestEvent {
  id          String           @id @default(cuid())
  requestId   String
  actorUserId String?
  action      LeaveEventAction
  level       Int?
  note        String?
  createdAt   DateTime         @default(now())

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

// ---------- Platform ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([entity, createdAt])
  @@index([actorUserId])
}

// ---------- Qualifications (PIM) ----------

model Nationality {
  id   String @id @default(cuid())
  name String @unique
}

model Qualification {
  id          String            @id @default(cuid())
  kind        QualificationKind
  name        String
  description String?
  createdAt   DateTime          @default(now())

  holders EmployeeQualification[]

  @@unique([kind, name])
}

model EmployeeQualification {
  id              String    @id @default(cuid())
  employeeId      String
  qualificationId String
  /// Skill: proficiency / years. License: - . Membership: subscription paid by.
  level           String?
  /// License number or membership id.
  number          String?
  issuedDate      DateTime? @db.Date
  expiryDate      DateTime? @db.Date
  amount          Decimal?  @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime  @default(now())

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  qualification Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([qualificationId])
}

// ---------- Time & attendance ----------

model WorkShift {
  id           String   @id @default(cuid())
  name         String   @unique
  /// HH:mm in the employee's location timezone
  startTime    String   @default("09:00")
  endTime      String   @default("18:00")
  breakMinutes Int      @default(60)
  graceMinutes Int      @default(0)
  /// 0 = Sunday .. 6 = Saturday
  workDays     Int[]    @default([1, 2, 3, 4, 5])
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  employees   Employee[]
  assignments ShiftAssignment[]
  changeRequests ShiftChangeRequest[]
}

model AttendancePunch {
  id          String          @id @default(cuid())
  employeeId  String
  at          DateTime
  direction   PunchDirection?
  source      PunchSource
  method      PunchMethod     @default(NONE)
  deviceId    String?
  latitude    Float?
  longitude   Float?
  note        String?
  /// Small JPEG selfie. Omitted from queries by default (see db client).
  photo       Bytes?
  createdById String?
  createdAt   DateTime        @default(now())

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, at])
  @@index([at])
}

model BiometricDevice {
  id         String    @id @default(cuid())
  name       String
  serial     String    @unique
  locationId String?
  apiKeyHash String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  location Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  punches  AttendancePunch[]
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- Timesheets ----------

model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  client    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  entries TimesheetEntry[]
}

model Timesheet {
  id           String          @id @default(cuid())
  employeeId   String
  /// Monday of the week
  weekStart    DateTime        @db.Date
  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  employee  Employee         @relation("TimesheetOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy Employee?        @relation("TimesheetDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  entries   TimesheetEntry[]

  @@unique([employeeId, weekStart])
  @@index([status])
}

model TimesheetEntry {
  id          String   @id @default(cuid())
  timesheetId String
  projectId   String
  activity    String?
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(4, 2)

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id])

  @@index([timesheetId])
  @@index([projectId])
  @@index([date])
}

// ---------- Recruitment ----------

model Vacancy {
  id              String        @id @default(cuid())
  title           String
  jobTitleId      String?
  departmentId    String?
  locationId      String?
  hiringManagerId String?
  positions       Int           @default(1)
  description     String?
  status          VacancyStatus @default(OPEN)
  /// Listed on the public /careers page
  isPublic        Boolean       @default(false)
  slug            String?       @unique
  closesAt        DateTime?     @db.Date
  /// Referral bonus paid after the hire passes 90 days, PHP
  referralBonus   Decimal?      @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  jobTitle      JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  location      Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  hiringManager Employee?   @relation(fields: [hiringManagerId], references: [id], onDelete: SetNull)
  candidates    Candidate[]
}

model Candidate {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  vacancyId       String?
  stage           CandidateStage @default(APPLIED)
  source          String?
  resumeUrl       String?
  notes           String?
  appliedAt       DateTime       @default(now()) @db.Date
  hiredEmployeeId String?        @unique
  /// AI resume screening (0-100), null until screened
  aiScore         Int?
  aiSummary       String?
  aiScreenedAt    DateTime?
  referrerId      String?
  /// PayrollAdjustment created for the referral bonus
  referralBonusAdjustmentId String?
  /// Data Privacy Act consent captured on the public apply form
  consentAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vacancy       Vacancy?    @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  hiredEmployee Employee?   @relation(fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  interviews    Interview[]
  documents     Document[]
  referrer      Employee?   @relation("CandidateReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  offers        JobOffer[]

  @@index([vacancyId])
  @@index([referrerId])
  @@index([stage])
}

model Interview {
  id            String          @id @default(cuid())
  candidateId   String
  title         String
  scheduledAt   DateTime
  interviewerId String?
  location      String?
  result        InterviewResult @default(PENDING)
  notes         String?
  round         Int             @default(1)
  createdAt     DateTime        @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer Employee? @relation(fields: [interviewerId], references: [id], onDelete: SetNull)
  feedback    InterviewFeedback[]

  @@index([candidateId])
  @@index([scheduledAt])
  @@index([interviewerId])
}

// ---------- Performance ----------

model Kpi {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Null = applies to everyone
  jobTitleId  String?
  minRating   Int      @default(1)
  maxRating   Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  jobTitle JobTitle?    @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  items    ReviewItem[]
}

model ReviewCycle {
  id          String            @id @default(cuid())
  name        String
  periodStart DateTime          @db.Date
  periodEnd   DateTime          @db.Date
  dueDate     DateTime          @db.Date
  status      ReviewCycleStatus @default(DRAFT)
  createdAt   DateTime          @default(now())

  reviews PerformanceReview[]
  goals   Goal[]
}

model PerformanceReview {
  id             String       @id @default(cuid())
  cycleId        String
  employeeId     String
  reviewerId     String?
  status         ReviewStatus @default(SELF_REVIEW)
  selfComment    String?
  managerComment String?
  finalRating    Decimal?     @db.Decimal(3, 2)
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cycle    ReviewCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee Employee     @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee?    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  items    ReviewItem[]
  peerFeedback PeerFeedback[]

  @@unique([cycleId, employeeId])
  @@index([reviewerId])
  @@index([employeeId])
}

model ReviewItem {
  id             String  @id @default(cuid())
  reviewId       String
  kpiId          String?
  kpiName        String
  minRating      Int
  maxRating      Int
  selfRating     Int?
  selfComment    String?
  managerRating  Int?
  managerComment String?

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  kpi    Kpi?              @relation(fields: [kpiId], references: [id], onDelete: SetNull)

  @@index([reviewId])
}

// ---------- Documents ----------

/// File bytes live in Postgres. `data` is omitted from queries by default (see db client).
model Document {
  id                String           @id @default(cuid())
  employeeId        String?
  candidateId       String?
  category          DocumentCategory
  name              String
  mimeType          String
  size              Int
  data              Bytes
  sha256            String
  uploadedById      String?
  visibleToEmployee Boolean          @default(true)
  /// Contracts, IDs, permits, certifications
  expiresAt         DateTime?        @db.Date
  /// Employee must acknowledge (e.g. signed policy, contract)
  requiresAck       Boolean          @default(false)
  caseId            String?
  createdAt         DateTime         @default(now())

  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  candidate  Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  expenseClaims ExpenseClaim[]
  acks          DocumentAck[]
  case          GrievanceCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)
  trainingCerts TrainingAttendee[]

  @@index([employeeId])
  @@index([candidateId])
  @@index([caseId])
  @@index([expiresAt])
}

// ---------- Payroll, requests, people ops, platform (2026-10) ----------

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
}

enum PayType {
  MONTHLY
  DAILY
}

enum PayFrequency {
  SEMI_MONTHLY
  MONTHLY
}

enum PayrollKind {
  REGULAR
  THIRTEENTH_MONTH
  OFF_CYCLE
  FINAL_PAY
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoanType {
  CASH_ADVANCE
  COMPANY_LOAN
  SSS_LOAN
  PAGIBIG_LOAN
}

enum LoanStatus {
  PENDING
  ACTIVE
  PAID
  REJECTED
  CANCELLED
}

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

enum TaskOwner {
  HR
  MANAGER
  EMPLOYEE
  IT
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  RETIRED
}

model PayrollRun {
  id          String        @id @default(cuid())
  name        String
  kind        PayrollKind   @default(REGULAR)
  frequency   PayFrequency  @default(SEMI_MONTHLY)
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  payDate     DateTime      @db.Date
  status      PayrollStatus @default(DRAFT)
  createdById String?
  finalizedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payslips      Payslip[]
  reimbursed    ExpenseClaim[]
  adjustments   PayrollAdjustment[]
  separations   Separation[]

  @@index([periodStart])
}

model Payslip {
  id              String   @id @default(cuid())
  runId           String
  employeeId      String
  basicPay        Decimal  @db.Decimal(12, 2)
  grossPay        Decimal  @db.Decimal(12, 2)
  sss             Decimal  @default(0) @db.Decimal(12, 2)
  philhealth      Decimal  @default(0) @db.Decimal(12, 2)
  pagibig         Decimal  @default(0) @db.Decimal(12, 2)
  withholdingTax  Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @db.Decimal(12, 2)
  netPay          Decimal  @db.Decimal(12, 2)
  /// Itemized earnings/deductions: [{ kind: "earning"|"deduction", code, label, amount, qty? }]
  lines           Json
  createdAt       DateTime @default(now())

  run          PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanPayments LoanPayment[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

model OvertimeRequest {
  id           String        @id @default(cuid())
  employeeId   String
  date         DateTime      @db.Date
  /// HH:mm local time
  startTime    String
  endTime      String
  minutes      Int
  reason       String
  status       RequestStatus @default(PENDING)
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  employee Employee  @relation("OvertimeOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee? @relation("OvertimeApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([status])
}

model CoeRequest {
  id                  String        @id @default(cuid())
  employeeId          String
  purpose             String
  includeCompensation Boolean       @default(false)
  status              RequestStatus @default(PENDING)
  decidedById         String?
  decidedAt           DateTime?
  note                String?
  createdAt           DateTime      @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model ExpenseClaim {
  id                String        @id @default(cuid())
  employeeId        String
  date              DateTime      @db.Date
  category          String
  amount            Decimal       @db.Decimal(12, 2)
  description       String
  status            RequestStatus @default(PENDING)
  approverId        String?
  decidedAt         DateTime?
  decisionNote      String?
  receiptId         String?
  reimbursedInRunId String?
  createdAt         DateTime      @default(now())

  employee   Employee    @relation("ExpenseOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver   Employee?   @relation("ExpenseApprover", fields: [approverId], references: [id], onDelete: SetNull)
  receipt    Document?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  reimbursedIn PayrollRun? @relation(fields: [reimbursedInRunId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
}

model Loan {
  id           String     @id @default(cuid())
  employeeId   String
  type         LoanType
  principal    Decimal    @db.Decimal(12, 2)
  /// Deducted per payroll run
  amortization Decimal    @db.Decimal(12, 2)
  balance      Decimal    @db.Decimal(12, 2)
  startDate    DateTime   @db.Date
  status       LoanStatus @default(PENDING)
  reason       String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([employeeId])
  @@index([status])
}

model LoanPayment {
  id        String   @id @default(cuid())
  loanId    String
  payslipId String?
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  note      String?

  loan    Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payslip Payslip? @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([payslipId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  pinned      Boolean   @default(false)
  requiresAck Boolean   @default(false)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  acks   AnnouncementAck[]

  @@index([publishedAt])
}

model AnnouncementAck {
  announcementId String
  userId         String
  ackedAt        DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

model ChecklistTemplate {
  id        String        @id @default(cuid())
  name      String
  kind      ChecklistKind
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())

  items      ChecklistTemplateItem[]
  checklists EmployeeChecklist[]
}

model ChecklistTemplateItem {
  id            String    @id @default(cuid())
  templateId    String
  title         String
  owner         TaskOwner @default(HR)
  /// Days after start (onboarding) or before last day (offboarding)
  dueOffsetDays Int       @default(0)
  sortOrder     Int       @default(0)

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model EmployeeChecklist {
  id          String        @id @default(cuid())
  employeeId  String
  kind        ChecklistKind
  templateId  String?
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks    EmployeeTask[]

  @@index([employeeId])
}

model EmployeeTask {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  owner       TaskOwner @default(HR)
  dueDate     DateTime? @db.Date
  doneAt      DateTime?
  doneById    String?
  sortOrder   Int       @default(0)

  checklist EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  doneBy    User?             @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@index([checklistId])
}

model Asset {
  id           String      @id @default(cuid())
  tag          String      @unique
  name         String
  category     String
  serialNumber String?
  purchaseDate DateTime?   @db.Date
  cost         Decimal?    @db.Decimal(12, 2)
  status       AssetStatus @default(AVAILABLE)
  assignedToId String?
  assignedAt   DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedTo Employee? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([assignedToId])
  @@index([status])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  date       DateTime @db.Date
  /// Null = rest day
  shiftId    String?
  note       String?
  createdAt  DateTime @default(now())

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    WorkShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}

model ShiftSwapRequest {
  id               String        @id @default(cuid())
  requesterId      String
  targetId         String
  date             DateTime      @db.Date
  reason           String?
  targetAcceptedAt DateTime?
  status           RequestStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())

  requester Employee @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    Employee @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([targetId])
  @@index([status])
}

model UserIdentity {
  id        String   @id @default(cuid())
  userId    String
  /// "google" | "microsoft"
  provider  String
  subject   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  /// Expo push token
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Round 3: payroll+, time+, recruitment+, lifecycle, growth (2026-10) ----------

enum AdjustmentKind {
  EARNING
  DEDUCTION
}

enum SeparationReason {
  RESIGNATION
  TERMINATION
  END_OF_CONTRACT
  RETIREMENT
  OTHER
}

enum SeparationStatus {
  CLEARANCE
  FINAL_PAY
  COMPLETED
  CANCELLED
}

enum CorrectionKind {
  MISSED_IN
  MISSED_OUT
  MISSED_BOTH
  WORK_FROM_HOME
  OFFICIAL_BUSINESS
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum Recommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

enum EmploymentEventType {
  HIRE
  PROMOTION
  TRANSFER
  SALARY_CHANGE
  STATUS_CHANGE
  SEPARATION
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  DONE
  DROPPED
}

enum TrainingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendeeStatus {
  INVITED
  ATTENDED
  ABSENT
}

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum CaseType {
  GRIEVANCE
  INCIDENT
  DISCIPLINARY
}

enum CaseStatus {
  OPEN
  NTE_ISSUED
  EXPLANATION_RECEIVED
  HEARING
  DECISION
  CLOSED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

/// One-off or recurring earnings/deductions picked up by payroll (bonus, incentive, arrears, HMO share, leave encashment, referral bonus)
model PayrollAdjustment {
  id             String         @id @default(cuid())
  employeeId     String
  kind           AdjustmentKind
  /// Short machine code, e.g. BONUS, INCENTIVE, ARREARS, HMO_EE, LEAVE_ENCASH, REFERRAL
  code           String
  label          String
  amount         Decimal        @db.Decimal(12, 2)
  taxable        Boolean        @default(true)
  /// First cutoff it applies to (by pay period containing this date)
  effectiveDate  DateTime       @db.Date
  /// Recurring adjustments apply every run until endDate
  recurring      Boolean        @default(false)
  endDate        DateTime?      @db.Date
  /// Set for one-off adjustments once paid in a finalized run
  appliedInRunId String?
  note           String?
  createdById    String?
  createdAt      DateTime       @default(now())

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  appliedIn PayrollRun? @relation(fields: [appliedInRunId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveDate])
  @@index([appliedInRunId])
}

/// Salary history. Employee.basicPay/payType/allowance mirror the latest row effective today.
model EmployeeCompensation {
  id            String   @id @default(cuid())
  employeeId    String
  effectiveFrom DateTime @db.Date
  payType       PayType
  basicPay      Decimal  @db.Decimal(12, 2)
  allowance     Decimal  @default(0) @db.Decimal(12, 2)
  reason        String?
  createdById   String?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model Separation {
  id              String           @id @default(cuid())
  employeeId      String
  reason          SeparationReason
  noticeDate      DateTime?        @db.Date
  lastDay         DateTime         @db.Date
  status          SeparationStatus @default(CLEARANCE)
  /// { answers: [{ q, a }], rating?, rehireEligible? }
  exitInterview   Json?
  /// Unused convertible leave to pay out
  leaveEncashDays Decimal?         @db.Decimal(5, 2)
  finalPayRunId   String?
  notes           String?
  createdById     String?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  finalPayRun  PayrollRun? @relation(fields: [finalPayRunId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
}

model BenefitPlan {
  id                String   @id @default(cuid())
  name              String
  provider          String
  /// HMO, LIFE, DENTAL, OTHER
  kind              String   @default("HMO")
  /// Monthly, PHP
  employerShare     Decimal  @default(0) @db.Decimal(12, 2)
  employeeShare     Decimal  @default(0) @db.Decimal(12, 2)
  perDependentShare Decimal  @default(0) @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  enrollments EmployeeBenefit[]
}

model EmployeeBenefit {
  id            String    @id @default(cuid())
  employeeId    String
  planId        String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  /// [{ name, relationship, birthDate }]
  dependents    Json      @default("[]")
  cardNo        String?
  createdAt     DateTime  @default(now())

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  plan     BenefitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([planId])
}

model AttendanceCorrection {
  id           String         @id @default(cuid())
  employeeId   String
  date         DateTime       @db.Date
  kind         CorrectionKind
  /// HH:mm local
  inTime       String?
  outTime      String?
  reason       String
  status       RequestStatus  @default(PENDING)
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())

  employee Employee  @relation("CorrectionOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee? @relation("CorrectionApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([status])
}

model CompOffRequest {
  id          String        @id @default(cuid())
  employeeId  String
  /// The rest day / holiday that was worked
  workDate    DateTime      @db.Date
  days        Decimal       @db.Decimal(4, 1)
  leaveTypeId String
  reason      String
  status      RequestStatus @default(PENDING)
  approverId  String?
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
}

model LeaveEncashment {
  id           String        @id @default(cuid())
  employeeId   String
  leaveTypeId  String
  year         Int
  days         Decimal       @db.Decimal(5, 2)
  amount       Decimal       @db.Decimal(12, 2)
  status       RequestStatus @default(PENDING)
  adjustmentId String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeId, year])
}

model LeaveBlockDate {
  id           String      @id @default(cuid())
  name         String
  from         DateTime    @db.Date
  to           DateTime    @db.Date
  /// Null = company-wide
  departmentId String?
  createdAt    DateTime    @default(now())

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([from])
}

model ShiftChangeRequest {
  id         String        @id @default(cuid())
  employeeId String
  from       DateTime      @db.Date
  to         DateTime      @db.Date
  /// Null = rest day
  shiftId    String?
  reason     String
  status     RequestStatus @default(PENDING)
  approverId String?
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())

  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    WorkShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
}

model Availability {
  id         String   @id @default(cuid())
  employeeId String
  /// 0 = Sunday .. 6 = Saturday
  weekday    Int
  /// HH:mm local; both null = unavailable all day
  fromTime   String?
  toTime     String?
  note       String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model JobOffer {
  id             String         @id @default(cuid())
  candidateId    String
  jobTitleId     String?
  departmentId   String?
  employmentType EmploymentType @default(FULL_TIME)
  payType        PayType        @default(MONTHLY)
  basicPay       Decimal        @db.Decimal(12, 2)
  allowance      Decimal        @default(0) @db.Decimal(12, 2)
  startDate      DateTime       @db.Date
  /// [{ label, value }]
  terms          Json           @default("[]")
  status         OfferStatus    @default(DRAFT)
  /// Secret for the public accept/decline link
  token          String         @unique
  expiresAt      DateTime?
  sentAt         DateTime?
  respondedAt    DateTime?
  /// Typed full name on acceptance
  signatureName  String?
  declineReason  String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  candidate  Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([candidateId])
}

model InterviewFeedback {
  id             String         @id @default(cuid())
  interviewId    String
  interviewerId  String
  /// { criterion: score 1-5 }
  scores         Json           @default("{}")
  rating         Int
  recommendation Recommendation
  comments       String?
  createdAt      DateTime       @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer Employee  @relation(fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
}

model EmploymentEvent {
  id            String              @id @default(cuid())
  employeeId    String
  type          EmploymentEventType
  effectiveDate DateTime            @db.Date
  /// Snapshot of changed fields before/after, e.g. { jobTitleId, departmentId, managerId, locationId, employmentStatus }
  from          Json?
  to            Json?
  note          String?
  /// Future-dated events are applied by the daily job
  appliedAt     DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveDate])
  @@index([appliedAt])
}

model Goal {
  id          String     @id @default(cuid())
  employeeId  String
  cycleId     String?
  parentId    String?
  title       String
  description String?
  /// Key result area
  kra         String?
  weight      Int        @default(0)
  progress    Int        @default(0)
  status      GoalStatus @default(NOT_STARTED)
  dueDate     DateTime?  @db.Date
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle    ReviewCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  parent   Goal?        @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Goal[]       @relation("GoalTree")

  @@index([employeeId])
  @@index([cycleId])
}

model PeerFeedback {
  id           String    @id @default(cuid())
  reviewId     String
  reviewerId   String
  rating       Int?
  strengths    String?
  improvements String?
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())

  review   PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewer Employee          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reviewerId])
  @@index([reviewerId])
}

model OneOnOne {
  id          String   @id @default(cuid())
  managerId   String
  employeeId  String
  date        DateTime @db.Date
  agenda      String?
  notes       String?
  /// [{ text, done }]
  actionItems Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager  Employee @relation("OneOnOneManager", fields: [managerId], references: [id], onDelete: Cascade)
  employee Employee @relation("OneOnOneEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([managerId])
  @@index([employeeId])
}

model TrainingProgram {
  id          String   @id @default(cuid())
  name        String
  description String?
  provider    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  events TrainingEvent[]
}

model TrainingEvent {
  id        String         @id @default(cuid())
  programId String
  title     String
  startsAt  DateTime
  endsAt    DateTime
  location  String?
  trainer   String?
  cost      Decimal?       @db.Decimal(12, 2)
  capacity  Int?
  status    TrainingStatus @default(SCHEDULED)
  createdAt DateTime       @default(now())

  program   TrainingProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  attendees TrainingAttendee[]

  @@index([startsAt])
}

model TrainingAttendee {
  id             String         @id @default(cuid())
  eventId        String
  employeeId     String
  status         AttendeeStatus @default(INVITED)
  /// PASSED | FAILED | free text
  result         String?
  score          Int?
  feedbackRating Int?
  feedback       String?
  certificateId  String?

  event       TrainingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certificate Document?     @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@unique([eventId, employeeId])
  @@index([employeeId])
}

model Survey {
  id          String       @id @default(cuid())
  title       String
  description String?
  /// [{ id, type: "rating"|"nps"|"choice"|"text", text, options? }]
  questions   Json
  anonymous   Boolean      @default(true)
  /// { departmentIds?: string[] } null = everyone
  audience    Json?
  status      SurveyStatus @default(DRAFT)
  opensAt     DateTime?
  closesAt    DateTime?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  responses      SurveyResponse[]
  participations SurveyParticipation[]
}

model SurveyResponse {
  id          String   @id @default(cuid())
  surveyId    String
  /// Null when the survey is anonymous
  employeeId  String?
  answers     Json
  submittedAt DateTime @default(now())

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

/// Who has responded (kept separate from answers so anonymous surveys can't be linked back)
model SurveyParticipation {
  surveyId    String
  employeeId  String
  submittedAt DateTime @default(now())

  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([surveyId, employeeId])
}

model GrievanceCase {
  id           String     @id @default(cuid())
  /// Employee the case is about
  employeeId   String
  raisedById   String?
  type         CaseType
  title        String
  description  String
  status       CaseStatus @default(OPEN)
  confidential Boolean    @default(true)
  nteIssuedAt  DateTime?
  /// Explanation deadline (at least 5 calendar days after NTE)
  nteDueAt     DateTime?
  explanation  String?
  hearingAt    DateTime?
  decision     String?
  sanction     String?
  closedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employee  Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  events    CaseEvent[]
  documents Document[]

  @@index([employeeId])
  @@index([status])
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  actorId   String?
  action    String
  note      String?
  createdAt DateTime @default(now())

  case  GrievanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId])
}

model CustomFieldDef {
  id        String          @id @default(cuid())
  /// Only "Employee" for now
  entity    String          @default("Employee")
  key       String          @unique
  label     String
  type      CustomFieldType @default(TEXT)
  options   String[]        @default([])
  required  Boolean         @default(false)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
}

model DocumentAck {
  documentId String
  userId     String
  ackedAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
}

// ---------- Hardening (2026-10) ----------

/// Fixed-window rate limit counters shared across serverless instances
model RateLimit {
  /// e.g. "login:ip:1.2.3.4" or "assistant:user:abc"
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}
